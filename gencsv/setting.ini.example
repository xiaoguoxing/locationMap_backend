; 配置模板 —— 复制为 setting.ini 后填入真实值
;
; 注意：setting.ini 含数据库凭据，已在 .gitignore 中排除，切勿提交入库。

[DATABASE]
host = <db-host>
port = 1433
database = <db-name>
username = <db-user>
password = <db-password>
tds_version = 7.2

; prod 环境示例（按需切换）
;host = <prod-db-host>
;port = 1433
;database = <prod-db-name>
;username = <prod-db-user>
;password = <prod-db-password>
;tds_version = 7.2

[PATHS]
; 相对于脚本所在目录
sql_folder = sql
output_folder = output
archive_folder = archive
log_folder = log

[JOBS]
; 逗号分隔的 SQL 文件名（不含路径）。
; date_range_runner.py 会忽略本项，它直接读取 sqltemplate 下所有 .sql。
files = cl2_free_1.sql
